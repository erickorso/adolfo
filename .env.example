# ── Base de datos (Supabase / Neon) ──
# Connection string de PostgreSQL. En Supabase usá el pooler para runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Auth.js (NextAuth v5) ──
# Generá AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET="<base64 32 bytes>"
# URL pública HTTPS (opcional si deployás en Vercel: se infiere de VERCEL_URL → https://tu-proyecto.vercel.app)
# AUTH_URL="https://tu-proyecto.vercel.app"
# OAuth de Google (opcional, para sumar login con Google):
# AUTH_GOOGLE_ID="<client id>"
# AUTH_GOOGLE_SECRET="<client secret>"
# Emails que se promueven a SUPERADMIN al loguearse (backoffice), separados por coma:
SUPERADMIN_EMAILS=""

# ── Ualá Bis API Cobros Online v2 ──
# Docs: https://developers.ualabis.com.ar/v2
# STAGE (pruebas locales):
UALA_AUTH_URL="https://auth.stage.developers.ar.ua.la/v2/api"
UALA_CHECKOUT_URL="https://checkout.stage.developers.ar.ua.la/v2/api"
# STAGE (pruebas locales): user_name + client_id + client_secret_id del bloque "STAGE" del mail.
UALA_USERNAME="<stage user_name>"
UALA_CLIENT_ID="<stage client_id>"
UALA_CLIENT_SECRET_ID="<stage client_secret_id>"
# PROD (deploy):
# UALA_AUTH_URL="https://auth.developers.ar.ua.la/v2/api"
# UALA_CHECKOUT_URL="https://checkout.developers.ar.ua.la/v2/api"
# Alias legacy (opcional): UALA_CLIENT_SECRET="<client secret id>"
# Dev sin credenciales: npm run dev:full → mock en :9999/v2/api
# El mock redirige a /api/dev/mock-uala-pay (webhook APPROVED + vacía carrito).
# STAGE: montos $25–$100 ARS; tarjeta del mail puede estar vencida (consultar soporte Ualá).

# ── Módulo de empleos ──
# Remotive: API pública, siempre activa en la ingesta.
# Greenhouse: boards opcionales, separados por coma (ej. "stripe,vercel").
JOBS_GREENHOUSE_BOARDS=""
# Bearer secret para autorizar POST /api/jobs/ingest y /api/rates/ingest (cron).
JOBS_INGEST_SECRET=""
# Vercel Cron: mismo valor que JOBS_INGEST_SECRET (Vercel lo envía como Bearer).
# CRON_SECRET=""

# ── Deploy producción (Vercel) ──
# 1. Postgres (Neon/Supabase) → DATABASE_URL (pooler para serverless).
# 2. Antes del primer deploy: npm run db:deploy
# 3. AUTH_URL opcional en Vercel (*.vercel.app se detecta solo vía VERCEL_URL).
# 4. UALA_* con credenciales PROD (erick.max + URLs developers.ar.ua.la).
# 5. STORAGE_DRIVER=blob + Blob store en Vercel (Storage → Create → Blob).
# 6. EMAIL_PROVIDER=resend + RESEND_API_KEY + EMAIL_FROM verificado.
# 7. SUPERADMIN_EMAILS=tu@email.com

# ── IA (asistente de CV) ──
# Proveedor de IA. Por ahora: "gemini".
AI_PROVIDER="gemini"
# API key gratis de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Nota: gemini-2.0-* puede tener free-tier en 0 según el proyecto/región; 2.5-flash sí tiene cuota gratis.
GEMINI_MODEL="gemini-2.5-flash"

# ── Email transaccional ──
# "console" loguea en stdout (dev). "resend" envía emails reales.
EMAIL_PROVIDER="console"
EMAIL_FROM="Catálogo <onboarding@resend.dev>"
# RESEND_API_KEY="re_..."

# ── Storage de objetos (CVs, imágenes) ──
# "local" dev · "blob" Vercel Blob (recomendado en Vercel) · "s3" AWS/R2
STORAGE_DRIVER="local"
# Auto-inyectado al crear Blob store en Vercel Dashboard → Storage:
# BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"

# ── App ──
NEXT_PUBLIC_APP_NAME="Catálogo"

# ── Dev local (seed + login programático para tests) ──
# GET /api/dev/login?secret=...&email=e2e@test.local&redirect=/es/account/applications
# Usuario E2E: e2e@test.local / password123 (npm run db:seed)
DEV_LOGIN_SECRET="dev-local-secret"

# Poné en "true" para saltear la validación de env (CI / scaffolding).
# SKIP_ENV_VALIDATION="false"
