// Prisma schema — catálogo y ventas (Productos + Servicios).
// Reglas de dominio aplicadas:
//  - Dinero SIEMPRE en enteros (centavos). Nunca floats.
//  - Estados modelados como enums, nunca strings sueltos.
//  - Payment lleva una clave de idempotencia única para tolerar webhooks duplicados.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// Enums (máquina de estados explícita)
// ──────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

/// Ciclo de vida de un pedido. Las transiciones válidas se validan en la capa de servicio.
enum OrderStatus {
  PENDING // recién creado, carrito confirmado
  AWAITING_PAYMENT // se generó el cobro en Ualá, esperando webhook
  PAID // pago aprobado y confirmado de forma atómica
  FULFILLED // entregado / servicio prestado
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

/// Discriminador para OrderItem: un ítem es un Producto o un Servicio.
enum ItemKind {
  PRODUCT
  SERVICE
}

/// Pipeline de búsqueda laboral del usuario (manual o vinculada a JobPosting).
enum JobApplicationStatus {
  SAVED
  APPLIED
  SCREEN
  TECH
  FINAL
  OFFER
  REJECTED
  GHOSTED
}

// ──────────────────────────────────────────────────────────────
// Modelos
// ──────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  /// Avatar (campo estándar de Auth.js).
  image         String?
  emailVerified DateTime?
  /// Hash de contraseña (proveedor Credentials). Null si solo usa OAuth.
  passwordHash  String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  bannedAt      DateTime?
  // Tablas estándar de Auth.js
  accounts      Account[]
  sessions      Session[]
  // Dominio de la app
  orders        Order[]
  savedJobs     SavedJob[]
  resumes       Resume[]
  jobApplications JobApplication[]
  courseEnrollments CourseEnrollment[]
  lessonProgress    LessonProgress[]
  learningProfile   LearningProfile?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
}

// ──────────────────────────────────────────────────────────────
// Auth.js (NextAuth) — tablas estándar del adapter de Prisma.
// Los usuarios viven en NUESTRA base, no en un servicio externo.
// ──────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  /// Nombre en español (canónico / fallback).
  name        String
  description String?
  /// Traducciones EN opcionales. Si null, se usa `name` / `description`.
  nameEn        String?
  descriptionEn String?
  /// Precio en centavos de la moneda (`currency`).
  priceCents  Int
  currency    String      @default("ARS")
  stock       Int         @default(0)
  imageUrl    String?
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  attributes  ProductAttribute[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active])
}

/// Atributo/propiedad custom de un producto (EAV). Flexible (cualquier name)
/// y consultable/indexado para búsquedas por propiedad.
model ProductAttribute {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  value     String

  @@index([productId])
  @@index([name, value])
}

model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  /// Nombre en español (canónico / fallback).
  name        String
  description String?
  nameEn        String?
  descriptionEn String?
  priceCents  Int
  currency    String      @default("ARS")
  /// Duración estimada del servicio en minutos.
  durationMin Int?
  imageUrl    String?
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active])
}

model Order {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  status     OrderStatus @default(PENDING)
  /// Total congelado al momento de la compra (suma de los ítems). En centavos.
  totalCents Int
  currency   String      @default("ARS")
  items      OrderItem[]
  payment    Payment?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

/// Snapshot de la línea de pedido. Guarda precio y nombre al momento de la compra
/// para que cambios futuros en el catálogo no alteren pedidos históricos.
model OrderItem {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  kind           ItemKind
  product        Product? @relation(fields: [productId], references: [id])
  productId      String?
  service        Service? @relation(fields: [serviceId], references: [id])
  serviceId      String?
  /// Nombre congelado al comprar.
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int      @default(1)

  @@index([orderId])
}

/// Un pago por pedido (1:1). La clave de idempotencia evita doble procesamiento
/// cuando Ualá reenvía el webhook.
model Payment {
  id                String        @id @default(cuid())
  order             Order         @relation(fields: [orderId], references: [id])
  orderId           String        @unique
  provider          String        @default("uala_bis")
  /// ID del cobro del lado de Ualá.
  providerPaymentId String?
  /// Clave única que generamos por intento de cobro; el webhook la usa para deduplicar.
  idempotencyKey    String        @unique
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  currency          String        @default("ARS")
  /// Payload crudo del webhook para auditoría.
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([providerPaymentId])
}

// ──────────────────────────────────────────────────────────────
// Módulo de empleos (bounded context separado del comercio).
// Ingesta desde fuentes estructuradas (APIs/feeds oficiales).
// ──────────────────────────────────────────────────────────────

/// Vacante normalizada proveniente de una fuente (Greenhouse, Lever, etc.).
model JobPosting {
  id          String     @id @default(cuid())
  /// Identificador de la fuente, ej. "greenhouse".
  source      String
  /// ID de la vacante dentro de la fuente. Único junto con `source`.
  externalId  String
  company     String
  title       String
  location    String?
  remote      Boolean    @default(false)
  /// Moderación: oculta la vacante del listado público.
  hidden      Boolean    @default(false)
  url         String
  description String?
  postedAt    DateTime?
  /// Última vez que la ingesta vio esta vacante.
  fetchedAt   DateTime       @default(now())
  savedBy     SavedJob[]
  reviews     ResumeReview[]
  applications JobApplication[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([company])
  @@index([remote])
}

/// Vacante guardada por un usuario (favoritos).
model SavedJob {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  createdAt DateTime   @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}

/// Seguimiento de postulaciones (ofertas externas o vacantes ingestadas).
model JobApplication {
  id           String               @id @default(cuid())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  job          JobPosting?          @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  jobPostingId String?
  company      String
  title        String
  url          String?
  /// Fuente de la oferta: Remotive, LinkedIn, inbound, etc.
  source       String?
  status       JobApplicationStatus @default(SAVED)
  appliedAt    DateTime?
  nextStep     String?
  notes        String?
  statusLogs   JobApplicationStatusLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([userId, status])
}

/// Historial de cambios de estado (progreso en el pipeline).
model JobApplicationStatusLog {
  id            String               @id @default(cuid())
  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  status        JobApplicationStatus
  note          String?
  createdAt     DateTime             @default(now())

  @@index([applicationId, createdAt])
}

/// CV subido por un usuario (máx. 3, validado en la capa de servicio).
model Resume {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  label         String
  /// Key del objeto en el storage (no la URL: los buckets privados firman URLs on-demand).
  storageKey    String
  mimeType      String
  sizeBytes     Int
  /// Texto extraído del archivo, para alimentar a la IA.
  extractedText String?
  isDefault     Boolean        @default(false)
  reviews       ResumeReview[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

/// Resultado de la mejora asistida por IA de un CV para una oferta puntual.
model ResumeReview {
  id          String      @id @default(cuid())
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId    String
  job         JobPosting? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId       String?
  /// Sugerencias de mejora (markdown).
  suggestions String?
  /// Reescritura completa adaptada a la oferta (markdown).
  rewrite     String?
  /// Modelo de IA utilizado.
  model       String?
  createdAt   DateTime    @default(now())

  @@index([resumeId])
}

// ──────────────────────────────────────────────────────────────
// Módulo de cursos (búsqueda + registro de interés del usuario).
// ──────────────────────────────────────────────────────────────

/// Curso formativo catalogado (SEPE, Formate.es, CAM, etc.).
model Course {
  id              String             @id @default(cuid())
  /// Fuente del catálogo, ej. "formate", "sepe-cam", "seed".
  source          String
  externalId      String?
  title           String
  description     String?
  provider        String
  url             String
  hours           Int
  modality        String             @default("online")
  sector          String?
  location        String?
  targetAudience  String?
  free            Boolean            @default(true)
  hidden          Boolean            @default(false)
  enrollments     CourseEnrollment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([source, externalId])
  @@index([hours])
  @@index([location])
  @@index([hidden])
}

/// Usuario registrado / interesado en un curso.
model CourseEnrollment {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// Aprendizaje interactivo (progreso por lección + gamificación).
// ──────────────────────────────────────────────────────────────

/// Progreso de una lección dentro de un módulo (ej. "ai-agents").
model LessonProgress {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// Identificador del módulo, ej. "ai-agents".
  moduleId    String
  /// Slug de la lección dentro del módulo.
  lessonSlug  String
  completedAt DateTime?
  xpEarned    Int       @default(0)
  quizScore   Int?
  quizPassedAt DateTime?
  quizXpEarned Int       @default(0)
  missionReadme  Boolean @default(false)
  missionVideo   Boolean @default(false)
  missionCode    Boolean @default(false)
  missionXpEarned Int    @default(0)

  @@unique([userId, moduleId, lessonSlug])
  @@index([userId, moduleId])
}

/// XP acumulado y racha de estudio del usuario.
model LearningProfile {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String    @unique
  totalXp          Int       @default(0)
  streakDays       Int       @default(0)
  lastActivityDate DateTime?
  certificateEarnedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

// ──────────────────────────────────────────────────────────────
// Cotización de moneda (cache). Display-only: el cobro sigue en ARS.
// Una fila por (source, type); se refresca por cron / read-through.
// ──────────────────────────────────────────────────────────────

model ExchangeRate {
  id        String   @id @default(cuid())
  source    String   @default("dolarapi")
  /// Tipo de dólar: "tarjeta" | "oficial" | "blue" | "mep" | ...
  type      String
  /// Compra: centavos ARS por 1 USD (ej. $1.450,00 → 145000).
  buyArsCents  Int
  /// Venta: centavos ARS por 1 USD (usada para convertir precios ARS → USD).
  sellArsCents Int
  fetchedAt DateTime @default(now())

  @@unique([source, type])
}

/// Muestra de campo (RUM) de Core Web Vitals — sin PII.
model WebVitalSample {
  id             String   @id @default(cuid())
  /// LCP | INP | CLS | FCP | TTFB
  name           String
  value          Float
  /// good | needs-improvement | poor
  rating         String
  delta          Float?
  navigationType String?
  pathname       String
  locale         String?
  createdAt      DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

/// Demo fullstack kit — ítems CRUD (microservicio + UI sandbox).
model KitItem {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
