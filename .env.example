# ── Base de datos (Supabase / Neon) ──
# Connection string de PostgreSQL. En Supabase usá el pooler para runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── Auth0 (SDK v4) ──
# Generá AUTH0_SECRET con: openssl rand -hex 32
AUTH0_SECRET="<32+ bytes hex>"
AUTH0_DOMAIN="tu-tenant.us.auth0.com"
AUTH0_CLIENT_ID="<client id>"
AUTH0_CLIENT_SECRET="<client secret>"
APP_BASE_URL="http://localhost:3000"

# ── Ualá Bis ──
UALA_API_BASE_URL="https://api.sandbox.uala.com.ar"
UALA_CLIENT_ID="<client id>"
UALA_CLIENT_SECRET="<client secret>"
UALA_WEBHOOK_SECRET="<secreto para verificar la firma del webhook>"

# ── App ──
NEXT_PUBLIC_APP_NAME="Catálogo"

# Poné en "true" para saltear la validación de env (CI / scaffolding).
# SKIP_ENV_VALIDATION="false"
