# Misma Neon que Adolfo (Prisma). Requerido.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# JWT propio del BFF mobile (no reutilices cookies de Next).
MOBILE_JWT_SECRET=change-me-to-a-long-random-string
MOBILE_JWT_EXPIRE_MINUTES=10080

# Puerto local
MOBILE_API_PORT=4002

# CORS CSV (RN/Flutter emulators + web)
MOBILE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Proxy ingest / AI → Next.js Adolfo
ADOLFO_BASE_URL=http://127.0.0.1:3000
JOBS_INGEST_SECRET=same-as-adolfo-JOBS_INGEST_SECRET
# Opcional: si distinto del ingest (default = JOBS_INGEST_SECRET)
# AI_GENERATE_SECRET=
